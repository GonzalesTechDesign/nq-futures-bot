# NQ Futures Trading Bot - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN SECRETS. NEVER COMMIT .env!

# Execution Mode: PAPER or LIVE
TRADING_MODE=PAPER

# Interactive Brokers (TWS / IB Gateway)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=DU_PAPER_DEFAULT

# Databento (CME GLBX.MDP3 Feed & Historical)
DATABENTO_API_KEY=db-your-databento-api-key-here

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Ngrok Tunnel (for TradingView webhooks)
# Set this to your ngrok host (e.g. "abc123.ngrok-free.dev") if using ngrok.
# Leave empty to use the local server URL. The dashboard will show the correct
# webhook URL based on this value.
NGROK_HOST=

# CORS Origins (comma-separated). If using ngrok, add your ngrok URL here too.
# Example: CORS_ORIGINS=http://localhost:8888,https://abc123.ngrok-free.dev
CORS_ORIGINS=
