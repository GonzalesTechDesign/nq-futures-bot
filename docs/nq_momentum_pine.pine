// ══════════════════════════════════════════════════════════════════════════
// NQ Momentum Strategy — Webhook to NQ Futures Bot
// Matches the auto-trader logic: SMA(5/20) crossover + RSI + momentum
// Sends BUY/SELL signals via webhook to your bot
// ══════════════════════════════════════════════════════════════════════════
//@version=5
strategy("NQ Momentum Bot", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_value=0.0002)

// ── Inputs ──────────────────────────────────────────────────────────────
smaFast     = input.int(5, "SMA Fast Period")
smaSlow     = input.int(20, "SMA Slow Period")
rsiPeriod   = input.int(14, "RSI Period")
rsiBuyThresh = input.float(35.0, "RSI Buy Below (Oversold)")
rsiSellThresh = input.float(65.0, "RSI Sell Above (Overbought)")
momentumPeriod = input.int(5, "Momentum Period")
buyScoreThreshold = input.float(0.60, "Buy Score Threshold")
sellScoreThreshold = input.float(0.40, "Sell Score Threshold")
qty = input.int(1, "Contracts per Trade")

// ── Indicators ──────────────────────────────────────────────────────────
smaF = ta.sma(close, smaFast)
smaS = ta.sma(close, smaSlow)
rsi = ta.rsi(close, rsiPeriod)
momentum = close - close[momentumPeriod]

// ── Score Calculation (matches backend strategy.py) ─────────────────────
score = 0.5

// SMA crossover factor
if smaF > smaS * 1.0005
    score += 0.15
else if smaF < smaS * 0.9995
    score -= 0.15

// Momentum factor
if momentum > 0
    score += 0.125
else if momentum < 0
    score -= 0.125

// RSI factor
if rsi < rsiBuyThresh
    score += 0.15
else if rsi > rsiSellThresh
    score -= 0.15
else if rsi > 40 and rsi < 60
    score -= 0.05

// SMA slope factor
smaFPrev = ta.sma(close[smaFast + 3], smaFast)
slope = (smaF - smaFPrev) / smaF
if slope > 0.0001
    score += 0.1
else if slope < -0.0001
    score -= 0.1

score := math.max(0.0, math.min(1.0, score))

// ── Trailing Stop ───────────────────────────────────────────────────────
trailStop = input.float(20.0, "Trailing Stop (points)")
var float trailingStop = na
var string posSide = "FLAT"

if strategy.position_size > 0
    newStop = close - trailStop
    trailingStop := na(trailingStop) ? newStop : math.max(trailingStop, newStop)
    posSide := "LONG"
else if strategy.position_size < 0
    newStop = close + trailStop
    trailingStop := na(trailingStop) ? newStop : math.min(trailingStop, newStop)
    posSide := "SHORT"
else
    trailingStop := na
    posSide := "FLAT"

// ── Exit Logic ──────────────────────────────────────────────────────────
if strategy.position_size > 0
    // Trailing stop exit
    if not na(trailingStop) and close <= trailingStop
        strategy.close("LONG", comment="TRAIL_STOP")
        posSide := "FLAT"
    // Signal reversal exit
    else if score < 0.4
        strategy.close("LONG", comment="REVERSAL")
        posSide := "FLAT"

else if strategy.position_size < 0
    if not na(trailingStop) and close >= trailingStop
        strategy.close("SHORT", comment="TRAIL_STOP")
        posSide := "FLAT"
    else if score > 0.6
        strategy.close("SHORT", comment="REVERSAL")
        posSide := "FLAT"

// ── Entry Logic ─────────────────────────────────────────────────────────
if score > buyScoreThreshold and strategy.position_size <= 0
    if strategy.position_size < 0
        strategy.close("SHORT")
    strategy.entry("LONG", strategy.long, qty=qty, comment="MOM_BUY")
    posSide := "LONG"

else if score < sellScoreThreshold and strategy.position_size >= 0
    if strategy.position_size > 0
        strategy.close("LONG")
    strategy.entry("SHORT", strategy.short, qty=qty, comment="MOM_SELL")
    posSide := "SHORT"

// ── Plots ───────────────────────────────────────────────────────────────
plot(smaF, "SMA Fast", color=color.new(color.green, 30), linewidth=1)
plot(smaS, "SMA Slow", color=color.new(color.red, 30), linewidth=1)
plot(not na(trailingStop) ? trailingStop : na, "Trailing Stop", color=color.new(color.yellow, 20), style=plot.style_linebr, linewidth=1)

// Score dashboard
var table scoreTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(scoreTable, 0, 0, "NQ MOMENTUM", text_color=color.white, text_size=size.small, bgcolor=color.new(color.green, 70))
    table.cell(scoreTable, 1, 0, "", bgcolor=color.new(color.green, 70))
    table.cell(scoreTable, 0, 1, "Score", text_color=color.white, text_size=size.small)
    table.cell(scoreTable, 1, 1, str.tostring(score, "#.###"), text_color=score > 0.6 ? color.green : score < 0.4 ? color.red : color.white, text_size=size.small)
    table.cell(scoreTable, 0, 2, "RSI", text_color=color.white, text_size=size.small)
    table.cell(scoreTable, 1, 2, str.tostring(rsi, "#.#"), text_color=rsi < 35 ? color.green : rsi > 65 ? color.red : color.white, text_size=size.small)
    table.cell(scoreTable, 0, 3, "SMA F/S", text_color=color.white, text_size=size.small)
    table.cell(scoreTable, 1, 3, smaF > smaS ? "BULL" : "BEAR", text_color=smaF > smaS ? color.green : color.red, text_size=size.small)
    table.cell(scoreTable, 0, 4, "Momentum", text_color=color.white, text_size=size.small)
    table.cell(scoreTable, 1, 4, str.tostring(momentum, "#.#"), text_color=momentum > 0 ? color.green : color.red, text_size=size.small)
    table.cell(scoreTable, 0, 5, "Position", text_color=color.white, text_size=size.small)
    table.cell(scoreTable, 1, 5, posSide, text_color=posSide == "LONG" ? color.green : posSide == "SHORT" ? color.red : color.gray, text_size=size.small)
